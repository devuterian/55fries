{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devuterian/55fries/schemas/pricing-rules.schema.json",
  "title": "55fries 가격 계산 규칙",
  "type": "object",
  "required": [
    "ruleset_id",
    "current_listing_max_age_days",
    "safe_trade_min_count",
    "sold_average_window_days",
    "alert_discount_percent",
    "alert_price_rounding_krw",
    "alert_min_price_krw",
    "caution_when_safe_trade_count_zero",
    "caution_when_safe_trade_history_unavailable",
    "current_low_order",
    "caution_label_zero",
    "caution_label_unavailable",
    "safe_label"
  ],
  "properties": {
    "ruleset_id": {"type": "string", "minLength": 1},
    "current_listing_max_age_days": {"const": 25},
    "safe_trade_min_count": {"const": 1},
    "sold_average_window_days": {"const": 90},
    "alert_discount_percent": {"const": 15},
    "alert_price_rounding_krw": {"const": 10000},
    "alert_min_price_krw": {"const": 100000},
    "caution_when_safe_trade_count_zero": {"const": true},
    "caution_when_safe_trade_history_unavailable": {"const": true},
    "current_low_order": {
      "const": ["판매중 최저가", "판매중-안전", "6개월 최저", "3개월 평균"]
    },
    "caution_label_zero": {"const": "주의 · 안전거래 0회"},
    "caution_label_unavailable": {"const": "주의 · 안전거래 이력 확인불가"},
    "safe_label": {"const": "안전거래 이력 확인됨"}
  },
  "additionalProperties": false
}
